{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "money-agent",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  },
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MONEY_AGENT",
        "class_name": "MoneyAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "MoneyAgent"
      ]
    }
  ],
  "vars": {
    "RUN_MODE": "live",
    "AI_MODEL": "@cf/zai-org/glm-4.7-flash",
    "AGENT_NAME": "Onigiri Money Agent",
    "AGENTBAZAAR_PRICE_USDC": "15",
    "AUTO_SWEEP_PAYOUTS": "true"
  }
}